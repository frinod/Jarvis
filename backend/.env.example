# JARVIS OS / FRINO OS — Environment Configuration
# Copy this file to .env and fill in your values
# You only need ONE AI provider key to enable full AI

# ── AI Providers (set any ONE key to enable that provider) ──
GEMINI_API_KEY=          # Free: https://aistudio.google.com/app/apikey
GROQ_API_KEY=            # Free: https://console.groq.com/keys
DEEPSEEK_API_KEY=        # Cheap: https://platform.deepseek.com
OPENAI_API_KEY=          # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# ── Model Names (defaults work, change only if needed) ──
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local, optional) ──
LOCAL_MODEL_PATH=        # e.g. http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Database ──
DATABASE_URL=sqlite:///jarvis.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ── Security ──
SECRET_KEY=change-me-to-a-random-secret-in-production

# ── Voice ──
WAKE_WORD=frino
TTS_ENGINE=pyttsx3

# ── App ──
DEBUG=false
